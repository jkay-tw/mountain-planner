{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mountain-planner:classic-route:1",
  "title": "IDEA-002 fixed route structure; source review is separately required",
  "type": "object",
  "required": [
    "schemaVersion",
    "routeId",
    "version",
    "name",
    "type",
    "verification",
    "direction",
    "directionStatus",
    "applicationStatus",
    "source",
    "occurrences",
    "directedSegments",
    "geometryBindings",
    "excludedNodeIds",
    "issues"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "routeId": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "out_and_back",
        "traverse",
        "loop",
        "multi_segment"
      ]
    },
    "verification": {
      "enum": [
        "candidate",
        "verified"
      ]
    },
    "direction": {
      "enum": [
        "forward",
        "reverse"
      ]
    },
    "directionStatus": {
      "enum": [
        "candidate",
        "manual-time-required",
        "blocked"
      ]
    },
    "applicationStatus": {
      "enum": [
        "blocked",
        "candidate-review"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "baseCommit",
        "snapshotRef",
        "snapshotSha256",
        "decisionRef",
        "decisionSha256",
        "geometrySha256",
        "spreadsheetId"
      ],
      "properties": {
        "baseCommit": {
          "type": "string",
          "minLength": 1
        },
        "snapshotRef": {
          "type": "string",
          "minLength": 1
        },
        "snapshotSha256": {
          "type": "string",
          "minLength": 1
        },
        "decisionRef": {
          "type": "string",
          "minLength": 1
        },
        "decisionSha256": {
          "type": "string",
          "minLength": 1
        },
        "geometrySha256": {
          "type": "string",
          "minLength": 1
        },
        "spreadsheetId": {
          "type": "string",
          "minLength": 1
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "excludedNodeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "occurrences": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "position",
          "nodeId",
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "boolean"
          }
        }
      }
    },
    "directedSegments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fromPosition",
          "toPosition",
          "edgeRef",
          "timeStatus"
        ],
        "additionalProperties": false,
        "properties": {
          "fromPosition": {
            "type": "integer",
            "minimum": 0
          },
          "toPosition": {
            "type": "integer",
            "minimum": 1
          },
          "timeStatus": {
            "enum": [
              "source-reference",
              "manual-required",
              "unknown"
            ]
          },
          "edgeRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromId",
              "toId",
              "kind",
              "graphDigest"
            ],
            "properties": {
              "fromId": {
                "type": "string",
                "minLength": 1
              },
              "toId": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "walking",
                  "owner-manual",
                  "vehicle",
                  "missing"
                ]
              },
              "graphDigest": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "geometryBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spanId",
          "reverse",
          "fromPosition",
          "toPosition"
        ],
        "properties": {
          "spanId": {
            "type": "string",
            "minLength": 1
          },
          "reverse": {
            "type": "boolean"
          },
          "fromPosition": {
            "type": "integer",
            "minimum": 0
          },
          "toPosition": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
